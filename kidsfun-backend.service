[Unit]
Description=KidsFun Backend API
After=network.target
Wants=network.target

[Service]
Type=exec
User=kidsfun
Group=kidsfun
WorkingDirectory=/opt/kidsfun-backend
Environment=PATH=/opt/kidsfun-backend/.env/bin
ExecStart=/opt/kidsfun-backend/.env/bin/gunicorn -c /opt/kidsfun-backend/gunicorn.conf.py main:app
ExecReload=/bin/kill -s HUP $MAINPID
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kidsfun-backend

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/kidsfun-backend/media /opt/kidsfun-backend/logs

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096

[Install]
WantedBy=multi-user.target 